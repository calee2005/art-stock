{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Art Stock",
  "version": "0.0.1",
  "identifier": "app.artstock.desktop",
  "build": {
    "frontendDist": "../webview"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Art Stock",
        "width": 1100,
        "height": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
