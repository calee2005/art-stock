{
  "name": "art-stock",
  "private": true,
  "version": "0.0.0",
  "description": "Art Stock — personal art asset manager (S3 protocol, no app server)",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "turbo run dev --filter=@art-stock/web",
    "dev:desktop": "turbo run dev --filter=@art-stock/desktop",
    "build:web": "turbo run build --filter=@art-stock/web",
    "test": "turbo run test --filter=@art-stock/core --filter=@art-stock/s3 --filter=@art-stock/web",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.9.2"
  }
}
